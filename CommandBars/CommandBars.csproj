<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net6.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CommandBars</RootNamespace>
    <AssemblyName>CommandBars</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Keep XML docs for IntelliSense, but don't fail/nag on members that are
         intentionally undocumented while the API surface is still settling. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Targets Windows-specific .NET because the control depends on
         System.Windows.Forms and System.Drawing (GDI+). The .NET 6 target is
         retained for Windows 7 test deployments. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Vector icon rasterization. Restored from nuget.org on build. -->
    <PackageReference Include="Svg" Version="3.4.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The out-of-process design-time server assembly calls internal preview
         hooks (RefreshDesignPreview / EnsureDesignBars). Required for
         CommandBars.Designer.Server to compile against the runtime library. -->
    <InternalsVisibleTo Include="CommandBars.Designer.Server" />
    <InternalsVisibleTo Include="CommandBars.Tests" />
  </ItemGroup>

</Project>
