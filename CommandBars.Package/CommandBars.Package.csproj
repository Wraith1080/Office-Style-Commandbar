<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packs the CommandBars runtime + its out-of-process design-time assemblies
    into the NuGet layout Visual Studio's WinForms designer expects. With the
    Package's own TFM = $(CommandBarsDesignTfm), the lib folder is
    lib/net8.0-windows10.0.18362.0/ and everything below it:

      lib/<tfm>/                          CommandBars.dll (+pdb/xml)   [runtime]
      lib/<tfm>/Design/WinForms/          CommandBars.Designer.Client.dll   (net472)
      lib/<tfm>/Design/WinForms/          CommandBars.Designer.Protocol.dll (net472)
      lib/<tfm>/Design/WinForms/Server/   CommandBars.Designer.Server.dll   (.NET)
      lib/<tfm>/Design/WinForms/Server/   CommandBars.Designer.Protocol.dll (.NET)

    The designer loads Server-side designers from Design/WinForms/Server and the
    VS-side (client) editors from Design/WinForms — exactly like Microsoft's
    TileRepeater sample.

    IMPORTANT: design-time support only activates when the consuming app
    references this PACKAGE (from the local feed in NuGet\BuildOut) — a project
    reference to CommandBars.csproj never loads the designer assemblies.

    The package version is date/time-derived so every build produces a new
    version; with Version="*" in the consumer this defeats NuGet's cache and
    guarantees the designer reloads freshly built assemblies. Build order
    (CommandBars, Protocol, Server, Client before this) is enforced by solution
    build dependencies in CommandBars.sln.
  -->
  <PropertyGroup>
    <TargetFramework>$(CommandBarsDesignTfm)</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>CommandBars.Package</PackageId>
    <Authors>Irfan Rahmat</Authors>
    <Description>Professional Office-style CommandBars for Windows Forms (dockable/floating, themeable, DPI-aware, SVG icons) with Visual Studio out-of-process designer support.</Description>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_GetFilesToPackage</TargetsForTfmSpecificContentInPackage>
    <PackageVersion>$([System.DateTime]::Now.ToString("1.yM.dHmm"))</PackageVersion>
    <!-- lib subfolders (Design/WinForms/...) are intentional; suppress the lib-layout warnings. -->
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Flows into the package as a real NuGet dependency, so consumers restore
         the SVG rasterizer the CommandBars runtime needs. Keep in sync with
         CommandBars.csproj. -->
    <PackageReference Include="Svg" Version="3.4.7" />
  </ItemGroup>

  <Target Name="_GetFilesToPackage">
    <PropertyGroup>
      <_CbRoot>$(MSBuildThisFileDirectory)..\</_CbRoot>
      <!-- Runtime library stays a plain net8.0-windows TFM, so its output folder
           is net8.0-windows (no platform version). The design projects use the
           platform-versioned $(CommandBarsDesignTfm). -->
      <_RuntimeTfm>net8.0-windows</_RuntimeTfm>
    </PropertyGroup>
    <ItemGroup>
      <!-- Runtime -->
      <_File Include="$(_CbRoot)CommandBars\bin\$(Configuration)\$(_RuntimeTfm)\CommandBars.dll" />
      <_File Include="$(_CbRoot)CommandBars\bin\$(Configuration)\$(_RuntimeTfm)\CommandBars.pdb" />
      <_File Include="$(_CbRoot)CommandBars\bin\$(Configuration)\$(_RuntimeTfm)\CommandBars.xml" />

      <!-- Server-side designers (.NET) -->
      <_File Include="$(_CbRoot)CommandBars.Designer.Server\bin\$(Configuration)\$(CommandBarsDesignTfm)\CommandBars.Designer.Server.dll" TargetDir="Design/WinForms/Server" />
      <_File Include="$(_CbRoot)CommandBars.Designer.Server\bin\$(Configuration)\$(CommandBarsDesignTfm)\CommandBars.Designer.Server.pdb" TargetDir="Design/WinForms/Server" />
      <_File Include="$(_CbRoot)CommandBars.Designer.Protocol\bin\$(Configuration)\$(CommandBarsDesignTfm)\CommandBars.Designer.Protocol.dll" TargetDir="Design/WinForms/Server" />

      <!-- Client-side editors (.NET Framework, loaded inside VS) -->
      <_File Include="$(_CbRoot)CommandBars.Designer.Client\bin\$(Configuration)\$(CommandBarsClientTfm)\CommandBars.Designer.Client.dll" TargetDir="Design/WinForms" />
      <_File Include="$(_CbRoot)CommandBars.Designer.Protocol\bin\$(Configuration)\$(CommandBarsClientTfm)\CommandBars.Designer.Protocol.dll" TargetDir="Design/WinForms" />
    </ItemGroup>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_File)" PackagePath="$(BuildOutputTargetFolder)/$(TargetFramework)/%(_File.TargetDir)" />
    </ItemGroup>
  </Target>

  <Target Name="CopyPackage" AfterTargets="Pack">
    <MakeDir Directories="$(MSBuildThisFileDirectory)..\NuGet\BuildOut" />
    <Copy SourceFiles="$(OutputPath)..\$(PackageId).$(PackageVersion).nupkg" DestinationFolder="$(MSBuildThisFileDirectory)..\NuGet\BuildOut\" />
  </Target>

</Project>
