<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Local feed for CommandBars.Package: the Package project drops every
       freshly packed .nupkg into NuGet\BuildOut, and CommandBars.PackageDemo
       restores it from here with Version="*". Everything else still comes from
       nuget.org. -->
  <packageSources>
    <clear />
    <add key="CommandBarsLocal" value=".\NuGet\BuildOut" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="LocalRepo" value="E:\Nuget" allowInsecureConnections="True" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="CommandBarsLocal">
      <package pattern="CommandBars.Package*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
