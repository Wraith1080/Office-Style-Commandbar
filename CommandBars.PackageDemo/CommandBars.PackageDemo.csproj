<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumes CommandBars as a NUGET PACKAGE from the local feed (NuGet\BuildOut)
    — this is what activates the out-of-process design-time assemblies in
    Visual Studio. Version="*" always picks the newest package the
    CommandBars.Package project produced.

    Build order matters the first time: build CommandBars.Package once (which
    builds CommandBars + CommandBars.Designer.Server and drops the .nupkg into
    NuGet\BuildOut), then restore/build this project. After a change to the
    library or designers, rebuild CommandBars.Package and restore again so the
    designer picks up the new version (close the form designer first).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.18362.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CommandBars.PackageDemo</RootNamespace>
    <AssemblyName>CommandBars.PackageDemo</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandBars.Package" Version="*" />
  </ItemGroup>

</Project>
