<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumes CommandBars as a NUGET PACKAGE from the local feed (NuGet\BuildOut)
    — this is what activates the out-of-process design-time assemblies in
    Visual Studio. Version="*" always picks the newest package the
    CommandBars.Package project produced.

    First build order: build CommandBars.Package once (which builds CommandBars,
    Protocol, Server, Client and drops the .nupkg into NuGet\BuildOut), then
    restore/build this project. After changing the library or designers, rebuild
    CommandBars.Package and restore again (close the form designer first) so the
    designer picks up the new package version.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CommandBars.PackageDemo</RootNamespace>
    <AssemblyName>CommandBars.PackageDemo</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandBars.Package" Version="1.267.131856" />
  </ItemGroup>

</Project>
