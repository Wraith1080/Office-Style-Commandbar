<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumes CommandBars as a NUGET PACKAGE from the local feed (NuGet\BuildOut)
    — this is what activates the out-of-process design-time assemblies in
    Visual Studio. The pinned version is advanced after each local package build
    so NuGet and the designer cannot reuse stale design-time assemblies.

    Build Server and Client first, then Package to pack their existing outputs
    into NuGet\BuildOut; see DESIGNER-SETUP.md. Restore this project after
    updating the package reference (close the form designer first).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CommandBars.PackageDemo</RootNamespace>
    <AssemblyName>CommandBars.PackageDemo</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandBars.Package" Version="1.269.51159" />
  </ItemGroup>

</Project>
