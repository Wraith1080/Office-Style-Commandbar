<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(CommandBarsDesignTfm)</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CommandBars.Designer.Server</RootNamespace>
    <AssemblyName>CommandBars.Designer.Server</AssemblyName>
    <!-- Pulls in Microsoft.WinForms.Designer.SDK via Directory.Build.targets
         (version centralized as WinFormsDesignerSdkVersion). -->
    <UseDesignerSDK>true</UseDesignerSDK>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommandBars\CommandBars.csproj" />
    <ProjectReference Include="..\CommandBars.Designer.Protocol\CommandBars.Designer.Protocol.csproj" />
  </ItemGroup>

</Project>
